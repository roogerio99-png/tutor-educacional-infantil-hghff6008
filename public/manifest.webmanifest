{
  "id": "/",
  "name": "Aprendiz — Tutor Educacional Inteligente",
  "short_name": "Aprendiz",
  "description": "Tutor educacional inteligente para crianças com voz humana real (Lumi IA), acompanhamento de rotina escolar e governança parental.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FFF8F0",
  "theme_color": "#F28C28",
  "prefer_related_applications": false,
  "categories": ["education", "kids", "productivity"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Painel do Responsável e Quadro Interativo do Aprendiz no Computador"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Aprendiz e Lumi IA no Celular dos Responsáveis"
    }
  ],
  "shortcuts": [
    {
      "name": "Conversar com a Lumi",
      "short_name": "Conversa",
      "description": "Abrir conversa por voz e texto com a Lumi",
      "url": "/conversa",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Agenda Escolar",
      "short_name": "Agenda",
      "description": "Ver atividades e rotina escolar da criança",
      "url": "/agenda",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Grafo & Painel do Responsável",
      "short_name": "Painel",
      "description": "Acompanhar evolução pedagógica e governança parental",
      "url": "/grafo-painel",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Aprendiz Mini-App",
      "short_name": "Mini-App",
      "description": "Versão leve para uso integrado",
      "url": "/embed",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/embed",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "titulo",
      "text": "pergunta",
      "url": "ref"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+lumi",
      "url": "/embed?pergunta=%s"
    }
  ]
}
